# Conformance expectations are generated by `generate.py`. Keeping them out of
# diffs and language statistics stops a corpus regeneration from reading as a
# few thousand lines of hand-written change.
tests/conformance/data/** linguist-generated=true

* text=auto

# The binary fixtures are GENERATED and never committed (see .gitignore), but
# name them anyway: an ALF payload is little-endian words and a gzip member is
# CRC-checked, so a line-ending filter that ever reached one would corrupt it
# silently and the corpus would fail on Windows only.
*.alp binary
*.ali binary
*.alc binary
*.all binary
*.alx binary
*.gz  binary
*.bin binary

# Committed text whose bytes are load-bearing. `CHECKSUMS.txt` is compared
# byte-for-byte by the determinism gate, and the JSON expectations are diffed
# against runner output, so a CRLF checkout would fail the suite on Windows for
# a reason that has nothing to do with the format.
LICENSE text eol=lf
NOTICE text eol=lf
tests/conformance/data/CHECKSUMS.txt text eol=lf
tests/conformance/data/**/*.json text eol=lf
